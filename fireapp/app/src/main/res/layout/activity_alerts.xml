<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Alert icon and heading -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_alert"
            android:tint="#EBE4E4"

            android:padding="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alerts"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Red Alert Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D32F2F"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:clipToOutline="true"
        android:backgroundTint="#D32F2F"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:gravity="center"
        >

        <TextView
            android:id="@+id/tvAlertMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fire Detected in Room 1!"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSmoke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smoke Level: 85%"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperature: 75°C"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Sound Alarm Button -->
    <LinearLayout
        android:id="@+id/btnSoundAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_card"
        android:padding="22dp"

        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sound Alarm"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#000000" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="#000000" />
    </LinearLayout>

    <!-- Send Alert Button -->
    <LinearLayout
        android:id="@+id/btnSendAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_card"
        android:padding="25dp"

        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send Alert"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#000000" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="#000000" />
    </LinearLayout>

    <!-- Status Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <View
            android:id="@+id/indicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:backgroundTint="#4CAF50"
            android:background="@drawable/green_dot"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Active Alerts"
            android:background="@drawable/rounded_white_card"
            android:padding="25dp"

            android:textSize="16sp"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Settings Button -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_white_card"
        android:text="SETTINGS"
        android:textAllCaps="true"
        android:backgroundTint="#D0C7C7"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>




