<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= MAIN SCROLL CONTENT ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:context=".StatusActivity">

        <LinearLayout
            android:id="@+id/mainContent"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ================= HEADER ================= -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/fireLogo"
                    android:src="@drawable/fire_logo"
                    android:contentDescription="Fire Logo"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/appTitle"
                    android:text="AI Powered Fire Prevention and Alert System"
                    android:textColor="@color/textWhite"
                    android:textStyle="bold"
                    android:textSize="26sp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <!-- ================= SYSTEM STATUS CARD ================= -->
            <LinearLayout
                android:id="@+id/systemStatusCard"
                android:background="@color/safeGreen"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/statusTitle"
                    android:text="System Status"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/statusValue"
                    android:text="SAFE"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- ================= SENSOR CARDS ================= -->


            <TextView
                android:id="@+id/espIpValue"
                android:text="ESP32 IP: 192.168.1.50"
                android:textColor="@color/textWhite"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <!-- Temperature -->
            <LinearLayout
                android:background="@drawable/card_bg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_temperature"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <TextView
                    android:id="@+id/tempValue"
                    android:text="Temperature: 32°C"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Gas -->
            <LinearLayout
                android:background="@drawable/card_bg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_gas"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <TextView
                    android:id="@+id/gasValue"
                    android:text="Gas Level: Normal"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Smoke -->
            <LinearLayout
                android:background="@drawable/card_bg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_smoke"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <TextView
                    android:id="@+id/smokeValue"
                    android:text="Smoke Level: Normal"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Water -->
            <LinearLayout
                android:background="@drawable/card_bg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/water_ic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <TextView
                    android:id="@+id/watervalue"
                    android:text="Water Level: Normal"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Risk -->
            <!-- Humidity -->
            <LinearLayout
                android:background="@drawable/card_bg"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_humidity"
                    android:layout_width="28dp"
                    android:layout_height="28dp"/>

                <TextView
                    android:id="@+id/humidityValue"
                    android:text="Humidity: 60%"
                    android:textSize="18sp"
                    android:layout_marginStart="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Button -->
            <LinearLayout
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnViewSensorData"
                    android:text="View Sensor Data"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ================= BOTTOM RECOMMENDATION OVERLAY ================= -->
    <LinearLayout
        android:id="@+id/recommendationCardBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#AA1E293B"
        android:padding="14dp"
        android:layout_margin="16dp"
        android:layout_gravity="bottom">

        <TextView
            android:id="@+id/tvSeverityBottom"
            android:text="Fire Severity: SAFE"
            android:textColor="@color/textWhite"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvRecommendationBottom"
            android:text="System is operating normally."
            android:textColor="@color/textWhite"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</FrameLayout>
